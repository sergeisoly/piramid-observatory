{
  "name": "piramid-observatory",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "An independent presentation of PIRAMID's interpretability research, with computed experiments and cited research results.",
  "scripts": {
    "dev": "vite",
    "dev:hold": "node tools/dev-updates.mjs hold",
    "dev:release": "node tools/dev-updates.mjs release",
    "dev:updates": "node tools/dev-updates.mjs status",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "shot": "node tools/shot.mjs",
    "check": "node tools/check.mjs",
    "publish:pages": "sh scripts/publish-pages.sh"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.1",
    "katex": "^0.16.25",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/three": "^0.187.0",
    "puppeteer-core": "^24.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
